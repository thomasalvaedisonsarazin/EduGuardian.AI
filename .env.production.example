# EduGuardian AI - SERVER settings. Copy to .env on the server and fill in every <...> value.
# NEVER commit the real file. See DEPLOY.md.

# --- Your website address (no https://, no slash) ---
DOMAIN=<your-domain.in>

ENVIRONMENT=production
# backup = daily database backup into ./backups; demo = reset the demo school every 24 hours.
COMPOSE_PROFILES=backup,demo

# --- Database (choose a long random password) ---
POSTGRES_USER=edu
POSTGRES_PASSWORD=<long-random-password>
POSTGRES_DB=eduguardian

# --- Auth ---
# Generate with: openssl rand -base64 48
SECRET_KEY=<long-random-secret-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["https://<your-domain.in>"]

# Public demo: only the seeded demo accounts can log in; nobody can create new schools.
ALLOW_REGISTRATION=false

# --- AI (OpenAI) ---
OPENAI_API_KEY=<sk-...>
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true
# Per-school and whole-server monthly AI spending caps, in US dollars.
LLM_MONTHLY_BUDGET_USD=5
LLM_GLOBAL_MONTHLY_BUDGET_USD=10
