# EduGuardian AI - copy to .env and adjust. NEVER commit .env.

# --- Database ---
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=eduguardian
# Used by a backend running directly on the host against the dev-stack db (published on 5433).
# Inside docker compose the backend always uses: postgresql+psycopg://edu:edu@db:5432/eduguardian
DATABASE_URL=postgresql+psycopg://edu:edu@localhost:5433/eduguardian

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (JSON list) ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_MONTHLY_BUDGET_USD=15

# --- Storage ---
REPORTS_DIR=/data/reports
UPLOADS_DIR=/data/uploads

# --- Frontend (baked in at build time) ---
VITE_API_URL=http://localhost:8000
